/* pages/record/record.wxss */

/* ===== 页面容器 ===== */
.page-scroll {
  height: 100vh;
}

/* ===== 顶部标题栏 ===== */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.top-title {
  font-size: 18px;
  font-weight: bold;
}
.top-actions {
  display: flex;
  gap: 14px;
}
.top-btn {
  font-size: 13px;
  color: #1677ff;
}
.clear-btn {
  color: #f53f3f;
}

/* ===== 统计卡片行 ===== */
.stats-row {
  display: flex;
  gap: 8px;
  margin-bottom: 14px;
}
.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 10px;
  padding: 12px 6px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.stat-num {
  display: block;
  font-size: 22px;
  font-weight: bold;
  color: #333;
}
.stat-num.blue { color: #1677ff; }
.stat-num.green { color: #52c41a; }
.stat-num.orange { color: #fa8c16; }
.unit {
  font-size: 13px;
  font-weight: normal;
}
.stat-label {
  display: block;
  font-size: 11px;
  color: #999;
  margin-top: 4px;
}

/* ===== 可视化折叠按钮 ===== */
.chart-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 10px;
  padding: 12px 14px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.toggle-title {
  font-size: 14px;
  font-weight: 500;
}
.toggle-arrow {
  font-size: 20px;
  color: #bbb;
  transition: transform 0.3s;
}
.toggle-arrow.open {
  transform: rotate(90deg);
}

/* ===== 可视化区域 ===== */
.chart-area {
  margin-bottom: 12px;
}
.chart-card {
  margin-bottom: 12px;
}
.chart-title {
  display: block;
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 12px;
}

/* 分类分布 - 横向进度条 */
.dist-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.dist-item {
  display: flex;
  align-items: center;
  gap: 8px;
}
.dist-label {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 72px;
  flex-shrink: 0;
  font-size: 12px;
  color: #555;
}
.dist-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.dist-bar-wrap {
  flex: 1;
  height: 14px;
  background: #f0f0f0;
  border-radius: 7px;
  overflow: hidden;
}
.dist-bar {
  height: 100%;
  border-radius: 7px;
  transition: width 0.6s ease;
  min-width: 2px;
}
.dist-count {
  width: 64px;
  flex-shrink: 0;
  font-size: 11px;
  color: #999;
  text-align: right;
}

/* 图表空状态 */
.chart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30px 0;
}
.chart-empty .empty-icon {
  font-size: 36px;
  opacity: 0.25;
  margin-bottom: 6px;
}
.chart-empty .empty-text {
  font-size: 13px;
  color: #bbb;
}

/* 近7天趋势 - CSS柱状图 */
.trend-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 160px;
  padding: 0 4px;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  max-width: 48px;
}
.trend-bar {
  width: 24px;
  border-radius: 4px 4px 0 0;
  min-height: 4px;
  transition: height 0.5s ease;
}
.trend-count {
  font-size: 10px;
  color: #1677ff;
  font-weight: 600;
  margin-bottom: 4px;
}
.trend-date {
  font-size: 10px;
  color: #999;
  margin-top: 6px;
}

/* ===== 筛选标签 ===== */
.tab-scroll {
  white-space: nowrap;
  margin-bottom: 14px;
}
.tab-row {
  display: inline-flex;
  gap: 8px;
}
.tab-item {
  display: inline-block;
  padding: 6px 14px;
  font-size: 12px;
  color: #666;
  background: #f5f5f5;
  border-radius: 16px;
  transition: all 0.3s;
}
.tab-item.active {
  background: #1677ff;
  color: #fff;
}

/* ===== 记录列表区 ===== */
.record-section {
  padding-bottom: 20px;
}
.section-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.section-label {
  font-size: 15px;
  font-weight: bold;
}
.section-count {
  font-size: 12px;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 0;
}
.empty-icon {
  font-size: 48px;
  opacity: 0.3;
  margin-bottom: 10px;
}
.empty-text {
  font-size: 14px;
  color: #999;
}
.empty-sub {
  font-size: 12px;
  color: #bbb;
  margin-top: 4px;
}

/* 日期分组 */
.date-group {
  margin-bottom: 14px;
}
.date-title {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #999;
  margin-bottom: 8px;
  padding-left: 2px;
}

/* 记录卡片 */
.record-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8px;
  padding: 12px 14px;
}
/* 左侧时间线 */
.item-left {
  margin-right: 10px;
  padding-top: 4px;
}
.item-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  box-shadow: 0 0 0 3px rgba(22,119,255,0.15);
}
/* 主体 */
.item-body {
  flex: 1;
}
.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}
.item-row:last-child {
  margin-bottom: 0;
}
.item-content {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}
.item-type {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 8px;
  font-weight: 500;
}
.item-type.blue {
  background: #e8f3ff;
  color: #1677ff;
}
.item-type.green {
  background: #eafff0;
  color: #52c41a;
}
.item-type.red {
  background: #fff0f0;
  color: #f53f3f;
}
.item-type.gray {
  background: #f5f5f5;
  color: #8c8c8c;
}
.item-time {
  font-size: 11px;
  color: #bbb;
}
.item-conf {
  font-size: 11px;
  color: #52c41a;
}
/* 右侧收藏 */
.item-right {
  margin-left: 8px;
  padding-top: 2px;
}
.fav-btn {
  font-size: 20px;
  color: #ddd;
  transition: color 0.2s;
}
.fav-btn.fav {
  color: #faad14;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20px 0 10px;
}
.load-text {
  font-size: 12px;
  color: #ccc;
}
