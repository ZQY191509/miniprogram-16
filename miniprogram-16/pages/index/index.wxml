<!--index.wxml-->
<scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">
<view class="container">

  <!-- ===== 搜索栏 ===== -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索想要分类的物品..." value="{{inputText}}" bindinput="onInputText" confirm-type="search" bindconfirm="onSearch" />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- ===== 轮播 Banner ===== -->
  <view class="banner-wrap">
    <view class="banner-card" wx:for="{{banners}}" wx:key="icon" wx:if="{{index === currentBanner}}">
      <text class="banner-icon">{{item.icon}}</text>
      <view class="banner-info">
        <text class="banner-title">{{item.title}}</text>
        <text class="banner-desc">{{item.desc}}</text>
      </view>
    </view>
    <view class="banner-dots">
      <view class="dot {{currentBanner === index ? 'active' : ''}}" wx:for="{{banners}}" wx:key="*this" data-index="{{index}}" bindtap="switchBanner"></view>
    </view>
  </view>

  <!-- ===== 快捷功能 ===== -->
  <view class="action-grid">
    <view class="action-item" wx:for="{{quickActions}}" wx:key="key" data-key="{{item.key}}" bindtap="onAction">
      <view class="action-icon">{{item.icon}}</view>
      <text class="action-text">{{item.text}}</text>
    </view>
  </view>

  <!-- ===== 分类输入卡片 ===== -->
  <view class="card input-card">
    <view class="card-header">
      <text class="card-title">智能分类</text>
      <text class="card-tag">AI识别</text>
    </view>
    <textarea placeholder="请输入需要分类的内容/物品名称..." class="input-area" value="{{inputText}}" bindinput="onInputText" maxlength="500"></textarea>

    <!-- 已选图片预览 -->
    <view class="image-preview" wx:if="{{imageList.length > 0}}">
      <view class="preview-item" wx:for="{{imageList}}" wx:key="*this">
        <image class="preview-img" src="{{item}}" mode="aspectFill"></image>
        <view class="preview-remove" data-index="{{index}}" bindtap="removeImage">✕</view>
      </view>
    </view>

    <view class="btn-row">
      <button size="mini" class="btn-outline" bindtap="chooseImage">
        <text>📎 上传图片</text>
      </button>
      <button size="mini" class="btn-primary-fill" bindtap="onStartClassify" loading="{{classifying}}" disabled="{{classifying}}">
        <text>✨ {{classifying ? '分类中...' : '开始分类'}}</text>
      </button>
    </view>
  </view>

  <!-- ===== 热门分类 ===== -->
  <view class="section-header">
    <text class="section-title">🔥 热门分类</text>
    <text class="section-more">查看全部 ›</text>
  </view>
  <scroll-view scroll-x class="hot-scroll" enhanced show-scrollbar="{{false}}">
    <view class="hot-item" wx:for="{{hotCategories}}" wx:key="name" style="background:{{item.color}}">
      <text class="hot-icon">{{item.icon}}</text>
      <text class="hot-name">{{item.name}}</text>
      <text class="hot-count">{{item.count}}</text>
    </view>
  </scroll-view>

  <!-- ===== 分类结果 ===== -->
  <view class="card result-card">
    <view class="card-header">
      <text class="card-title">分类结果</text>
      <text class="card-count" wx:if="{{resultData}}">共 {{resultData.length}} 项</text>
    </view>
    <!-- 空状态 -->
    <view class="empty" wx:if="{{!resultData}}">
      <view class="empty-icon">📋</view>
      <text class="empty-txt">输入内容后，点击「开始分类」查看结果</text>
    </view>
    <!-- 结果列表：纵向排列 -->
    <view class="result-list" wx:else>
      <view class="result-item" wx:for="{{resultData}}" wx:key="content">
        <view class="result-index">{{index + 1}}</view>
        <view class="result-body">
          <text class="result-content">{{item.content}}</text>
        </view>
        <view class="result-category" style="background:{{item.category === '可回收物' ? '#1677ff' : item.category === '厨余垃圾' ? '#52c41a' : item.category === '有害垃圾' ? '#f53f3f' : '#8c8c8c'}}; color:#fff">
          {{item.category}}
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 每日小贴士 ===== -->
  <view class="tip-card">
    <view class="tip-head">
      <text class="tip-icon">💡</text>
      <text class="tip-title">每日分类小贴士</text>
    </view>
    <text class="tip-content">{{tip}}</text>
    <view class="tip-tags">
      <text class="tag">有害垃圾</text>
      <text class="tag">废电池</text>
      <text class="tag">环保知识</text>
    </view>
  </view>

</view>
</scroll-view>
