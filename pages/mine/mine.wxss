/* pages/mine/mine.wxss */
/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
}
.avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  margin-right: 15px;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
}
.user-name {
  font-size: 16px;
  font-weight: bold;
  display: block;
  margin-bottom: 5px;
}
.user-desc {
  font-size: 12px;
  color: #999;
}
/* 菜单列表 */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f5f5f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.arrow {
  font-size: 20px;
  color: #999;
  font-weight: 300;
}
/* 版权 */
.copyright {
  text-align: center;
  font-size: 12px;
  color: #999;
  margin-top: 30px;
}