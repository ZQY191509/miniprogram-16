/* pages/guide/guide.wxss */

/* 顶部介绍 */
.guide-intro {
  text-align: center;
  padding: 10px 0 15px;
}
.intro-title {
  display: block;
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 6px;
}
.intro-desc {
  font-size: 12px;
  color: #999;
}

/* 分类卡片 */
.category-card {
  overflow: hidden;
  transition: all 0.3s ease;
}
.category-card.expanded {
  box-shadow: 0 4px 16px rgba(0,0,0,0.08);
}

/* 卡片头部 */
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.head-left {
  display: flex;
  align-items: center;
  flex: 1;
}
.cate-icon {
  font-size: 32px;
  margin-right: 12px;
  width: 44px;
  text-align: center;
}
.head-info {
  flex: 1;
}
.cate-name {
  display: block;
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 3px;
}
.cate-desc {
  display: block;
  font-size: 12px;
  color: #999;
}
.expand-arrow {
  font-size: 22px;
  color: #ccc;
  transition: transform 0.25s ease;
  font-weight: 300;
}
.expand-arrow.rotated {
  transform: rotate(90deg);
}

/* 展开内容 */
.card-body {
  margin-top: 12px;
}
.divider {
  height: 2px;
  border-radius: 1px;
  margin-bottom: 12px;
  opacity: 0.3;
}
.body-title {
  display: block;
  font-size: 13px;
  color: #666;
  font-weight: 500;
  margin-bottom: 8px;
}

/* 物品列表 */
.rule-item {
  display: flex;
  padding: 10px 0;
  border-bottom: 1px dashed #f0f0f0;
}
.rule-item:last-child {
  border-bottom: none;
}
.rule-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-top: 5px;
  margin-right: 10px;
  flex-shrink: 0;
}
.rule-info {
  flex: 1;
}
.rule-name {
  display: block;
  font-size: 14px;
  color: #333;
  font-weight: 500;
}
.rule-note {
  display: block;
  font-size: 11px;
  color: #999;
  margin-top: 3px;
  line-height: 1.5;
}

/* 底部提示 */
.tip-card {
  display: flex;
  align-items: center;
  background: #fffbe6;
  border: 1px solid #ffe58f;
  border-radius: 10px;
  padding: 12px 15px;
  margin-top: 5px;
}
.tip-icon {
  font-size: 20px;
  margin-right: 10px;
}
.tip-text {
  flex: 1;
  font-size: 12px;
  color: #ad8b00;
  line-height: 1.5;
}
