<!--pages/guide/guide.wxml-->
<view class="container">
  <view class="guide-intro">
    <text class="intro-title">垃圾分类速查手册</text>
    <text class="intro-desc">点击卡片展开查看每类垃圾的详细说明和常见物品</text>
  </view>

  <view
    class="card category-card {{activeIndex === index ? 'expanded' : ''}}"
    wx:for="{{categories}}"
    wx:for-item="cate"
    wx:key="id"
    data-index="{{index}}"
    bindtap="toggleCard"
  >
    <!-- 卡片头部 -->
    <view class="card-head">
      <view class="head-left">
        <text class="cate-icon">{{cate.icon}}</text>
        <view class="head-info">
          <text class="cate-name" style="color:{{cate.color}}">{{cate.name}}</text>
          <text class="cate-desc">{{cate.desc}}</text>
        </view>
      </view>
      <text class="expand-arrow {{activeIndex === index ? 'rotated' : ''}}">›</text>
    </view>

    <!-- 展开内容 -->
    <view class="card-body" wx:if="{{activeIndex === index}}">
      <view class="divider" style="background:{{cate.color}}"></view>
      <text class="body-title">常见物品：</text>
      <view class="rule-list">
        <view class="rule-item" wx:for="{{cate.rules}}" wx:for-item="rule" wx:key="rule.item">
          <view class="rule-dot" style="background:{{cate.color}}"></view>
          <view class="rule-info">
            <text class="rule-name">{{rule.item}}</text>
            <text class="rule-note">{{rule.note}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="tip-card">
    <text class="tip-icon">💡</text>
    <text class="tip-text">不确定如何分类时，可返回首页使用智能分类功能自动识别</text>
  </view>
</view>
