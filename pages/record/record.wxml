<!--pages/record/record.wxml-->
<scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">
<view class="container">

  <!-- ===== 标题栏 ===== -->
  <view class="top-bar">
    <text class="top-title">分类记录</text>
    <view class="top-actions">
      <text class="top-btn" bindtap="onExport">📤 导出</text>
      <text class="top-btn clear-btn">清空</text>
    </view>
  </view>

  <!-- ===== 统计概览 ===== -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num">{{stats.total}}</text>
      <text class="stat-label">总记录</text>
    </view>
    <view class="stat-card">
      <text class="stat-num blue">{{stats.today}}</text>
      <text class="stat-label">今日</text>
    </view>
    <view class="stat-card">
      <text class="stat-num green">{{stats.week}}</text>
      <text class="stat-label">本周</text>
    </view>
    <view class="stat-card">
      <text class="stat-num orange">{{stats.accuracy}}<text class="unit">%</text></text>
      <text class="stat-label">准确率</text>
    </view>
  </view>

  <!-- ===== 可视化区（可折叠） ===== -->
  <view class="chart-toggle" bindtap="toggleCharts">
    <text class="toggle-title">📊 数据可视化</text>
    <text class="toggle-arrow {{showCharts ? 'open' : ''}}">›</text>
  </view>

  <view class="chart-area" wx:if="{{showCharts}}">
    <!-- 分类分布 -->
    <view class="card chart-card">
      <text class="chart-title">分类分布</text>
      <view class="dist-item" wx:for="{{categoryDist}}" wx:key="name">
        <view class="dist-head">
          <view class="dist-dot" style="background:{{item.color}}"></view>
          <text class="dist-name">{{item.name}}</text>
          <text class="dist-count">{{item.count}}次</text>
        </view>
        <view class="dist-bar">
          <view class="dist-fill" style="width:{{item.pct}}%; background:{{item.color}}"></view>
        </view>
      </view>
    </view>

    <!-- 近7天趋势 -->
    <view class="card chart-card">
      <text class="chart-title">近7天趋势</text>
      <view class="trend-chart">
        <view class="trend-col" wx:for="{{weekTrend}}" wx:key="date">
          <text class="trend-val">{{item.count}}</text>
          <view class="trend-bar" style="height:{{item.count * 12}}px; background:{{item.color}}"></view>
          <text class="trend-date">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 筛选标签 ===== -->
  <scroll-view scroll-x class="tab-scroll" enhanced show-scrollbar="{{false}}">
    <view class="tab-row">
      <view
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="switchTab"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- ===== 记录列表 ===== -->
  <view class="record-section">
    <view class="section-bar">
      <text class="section-label">历史记录</text>
      <text class="section-count">共 {{stats.total}} 条</text>
    </view>

    <!-- 今天 -->
    <view class="date-group">
      <text class="date-title">今天</text>

      <view class="card record-item" wx:for="{{records}}" wx:key="id" wx:if="{{index < 3}}">
        <view class="item-left">
          <view class="item-dot" style="background:{{index === 0 ? '#1677ff' : index === 1 ? '#52c41a' : '#f53f3f'}}"></view>
        </view>
        <view class="item-body">
          <view class="item-row">
            <text class="item-content">{{item.content}}</text>
            <text class="item-type {{index === 0 ? 'blue' : index === 1 ? 'green' : 'red'}}">{{item.category}}</text>
          </view>
          <view class="item-row">
            <text class="item-time">{{item.time}}</text>
            <text class="item-conf">置信度 {{item.confidence}}%</text>
          </view>
        </view>
        <view class="item-right">
          <text class="fav-btn {{item.favorited ? 'fav' : ''}}" data-id="{{item.id}}" bindtap="toggleFavorite">{{item.favorited ? '⭐' : '☆'}}</text>
        </view>
      </view>
    </view>

    <!-- 昨天 -->
    <view class="date-group">
      <text class="date-title">昨天</text>

      <view class="card record-item" wx:for="{{records}}" wx:key="id" wx:if="{{index >= 3 && index < 5}}">
        <view class="item-left">
          <view class="item-dot" style="background:{{index === 3 ? '#1677ff' : '#8c8c8c'}}"></view>
        </view>
        <view class="item-body">
          <view class="item-row">
            <text class="item-content">{{item.content}}</text>
            <text class="item-type {{index === 3 ? 'blue' : 'gray'}}">{{item.category}}</text>
          </view>
          <view class="item-row">
            <text class="item-time">{{item.time}}</text>
            <text class="item-conf">置信度 {{item.confidence}}%</text>
          </view>
        </view>
        <view class="item-right">
          <text class="fav-btn" data-id="{{item.id}}" bindtap="toggleFavorite">☆</text>
        </view>
      </view>
    </view>

    <!-- 更早 -->
    <view class="date-group">
      <text class="date-title">05/31</text>

      <view class="card record-item" wx:for="{{records}}" wx:key="id" wx:if="{{index >= 5}}">
        <view class="item-left">
          <view class="item-dot" style="background:#f53f3f"></view>
        </view>
        <view class="item-body">
          <view class="item-row">
            <text class="item-content">{{item.content}}</text>
            <text class="item-type red">{{item.category}}</text>
          </view>
          <view class="item-row">
            <text class="item-time">{{item.time}}</text>
            <text class="item-conf">置信度 {{item.confidence}}%</text>
          </view>
        </view>
        <view class="item-right">
          <text class="fav-btn">☆</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more">
      <text class="load-text">— 上拉加载更多 —</text>
    </view>
  </view>

</view>
</scroll-view>
