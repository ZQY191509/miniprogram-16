<!--pages/record/record.wxml-->
<scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">
<view class="container">

  <!-- ===== 标题栏 ===== -->
  <view class="top-bar">
    <text class="top-title">分类记录</text>
    <view class="top-actions">
      <text class="top-btn" bindtap="onExport">📤 导出</text>
      <text class="top-btn clear-btn" bindtap="onClear">清空</text>
    </view>
  </view>

  <!-- ===== 统计概览 ===== -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num">{{stats.total}}</text>
      <text class="stat-label">总记录</text>
    </view>
    <view class="stat-card">
      <text class="stat-num blue">{{stats.today}}</text>
      <text class="stat-label">今日</text>
    </view>
    <view class="stat-card">
      <text class="stat-num green">{{stats.week}}</text>
      <text class="stat-label">本周</text>
    </view>
    <view class="stat-card">
      <text class="stat-num orange">{{stats.accuracy}}<text class="unit">%</text></text>
      <text class="stat-label">准确率</text>
    </view>
  </view>

  <!-- ===== 可视化区（可折叠） ===== -->
  <view class="chart-toggle" bindtap="toggleCharts">
    <text class="toggle-title">📊 数据可视化</text>
    <text class="toggle-arrow {{showCharts ? 'open' : ''}}">›</text>
  </view>

  <view class="chart-area" wx:if="{{showCharts}}">
    <!-- 分类分布 -->
    <view class="card chart-card">
      <text class="chart-title">分类分布</text>
      <view class="dist-list" wx:if="{{stats.total > 0}}">
        <view class="dist-item" wx:for="{{categoryDist}}" wx:key="name">
          <view class="dist-label">
            <view class="dist-dot" style="background:{{item.color}}"></view>
            <text>{{item.name}}</text>
          </view>
          <view class="dist-bar-wrap">
            <view class="dist-bar" style="width:{{item.pct}};background:{{item.color}}"></view>
          </view>
          <text class="dist-count">{{item.count}}次 {{item.pct}}%</text>
        </view>
      </view>
      <view class="chart-empty" wx:else>
        <text class="empty-icon">📊</text>
        <text class="empty-text">暂无数据</text>
      </view>
    </view>

    <!-- 近7天趋势 -->
    <view class="card chart-card">
      <text class="chart-title">近7天趋势</text>
      <view class="trend-bars" wx:if="{{stats.total > 0}}">
        <view class="trend-col" wx:for="{{weekTrend}}" wx:key="date">
          <text class="trend-count" wx:if="{{item.count > 0}}">{{item.count}}</text>
          <view class="trend-bar" style="height:{{item.count * 20 + 8}}px;background:{{item.color}}"></view>
          <text class="trend-date">{{item.date}}</text>
        </view>
      </view>
      <view class="chart-empty" wx:else>
        <text class="empty-icon">📈</text>
        <text class="empty-text">暂无数据</text>
      </view>
    </view>
  </view>

  <!-- ===== 筛选标签 ===== -->
  <scroll-view scroll-x class="tab-scroll" enhanced show-scrollbar="{{false}}">
    <view class="tab-row">
      <view
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="switchTab"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- ===== 记录列表 ===== -->
  <view class="record-section">
    <view class="section-bar">
      <text class="section-label">历史记录</text>
      <text class="section-count">共 {{stats.total}} 条</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{dateGroups.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无分类记录</text>
      <text class="empty-sub">前往首页开始智能分类吧</text>
    </view>

    <!-- 按日期分组 -->
    <view class="date-group" wx:for="{{dateGroups}}" wx:key="date">
      <text class="date-title">{{item.label}}</text>

      <view class="card record-item" wx:for="{{item.items}}" wx:for-item="record" wx:key="_id">
        <view class="item-left">
          <view class="item-dot" style="background:{{record.dotColor}}"></view>
        </view>
        <view class="item-body">
          <view class="item-row">
            <text class="item-content">{{record.content}}</text>
            <text class="item-type {{record.typeClass}}">{{record.category}}</text>
          </view>
          <view class="item-row">
            <text class="item-time">{{record.displayTime}}</text>
          </view>
        </view>
        <view class="item-right">
          <text class="fav-btn {{record.favorited ? 'fav' : ''}}" data-id="{{record._id}}" bindtap="toggleFavorite">{{record.favorited ? '⭐' : '☆'}}</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{dateGroups.length > 0}}">
      <text class="load-text">— 上拉加载更多 —</text>
    </view>
  </view>

</view>
</scroll-view>
